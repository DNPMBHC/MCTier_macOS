{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCTier",
  "version": "3.10.0",
  "identifier": "com.mctier.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MCTier - 虚拟局域网通用联机工具",
        "width": 320,
        "height": 520,
        "minWidth": 320,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "visible": true,
        "fullscreen": false,
        "maximizable": true,
        "zoomHotkeysEnabled": false,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"]
  }
}
